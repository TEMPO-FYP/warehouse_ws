<?xml version="1.0" encoding="UTF-8"?>
<robot name="bcr_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="bcr_arm_"/>
  <xacro:property name="p" value="$(arg prefix)"/>

  <!-- Planning Groups -->
  <group name="bcr_arm">
    <chain base_link="${p}base_link" tip_link="${p}grasp_tcp"/>
  </group>

  <group name="bcr_gripper">
    <joint name="robotiq_85_left_knuckle_joint"/>
  </group>

  <!-- Named Group States (bcr_arm) -->
  <group_state name="home" group="bcr_arm">
    <joint name="joint1" value="0.0347"/>
    <joint name="joint2" value="0.2729"/>
    <joint name="joint3" value="-1.3531"/>
    <joint name="joint4" value="1.1348"/>
    <joint name="joint5" value="2.5328"/>
    <joint name="joint6" value="-1.0486"/>
    <joint name="joint7" value="-1.145"/>
  </group_state>

  <group_state name="pre_fold" group="bcr_arm">
    <joint name="joint1" value="0.0347"/>
    <joint name="joint2" value="0.2729"/>
    <joint name="joint3" value="-1.3531"/>
    <joint name="joint4" value="1.1348"/>
    <joint name="joint5" value="2.5328"/>
    <joint name="joint6" value="-1.0486"/>
    <joint name="joint7" value="-1.145"/>
  </group_state>

  <group_state name="upright" group="bcr_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.0"/>
    <joint name="joint3" value="0.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
    <joint name="joint7" value="0.0"/>
  </group_state>

  <!-- Named Group States (bcr_gripper) -->
  <group_state name="open" group="bcr_gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.0"/>
  </group_state>

  <group_state name="attach" group="bcr_gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.45"/>
  </group_state>

  <group_state name="close" group="bcr_gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.75"/>
  </group_state>

  <!-- End Effector -->
  <end_effector name="gripper_ee" parent_link="${p}grasp_tcp" group="bcr_gripper" parent_group="bcr_arm"/>

  <!-- Virtual Joint connecting robot mount to global map frame -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="map" child_link="${p}mount_link"/>

  <!-- Disable self-collisions for pedestal & arm links -->
  <disable_collisions link1="${p}pedestal_link" link2="${p}base_link" reason="Adjacent"/>
  <disable_collisions link1="${p}pedestal_link" link2="${p}link1" reason="Never"/>
  <disable_collisions link1="${p}pedestal_link" link2="${p}link2" reason="Never"/>

  <disable_collisions link1="${p}base_link" link2="${p}flange" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}link1" reason="Adjacent"/>
  <disable_collisions link1="${p}base_link" link2="${p}link2" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}link3" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}link4" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}link5" reason="Never"/>
  <disable_collisions link1="${p}base_link" link2="${p}link6" reason="Never"/>

  <disable_collisions link1="${p}flange" link2="${p}link1" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}link2" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}link3" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}link4" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}link5" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}link6" reason="Adjacent"/>

  <disable_collisions link1="${p}link1" link2="${p}link2" reason="Adjacent"/>
  <disable_collisions link1="${p}link1" link2="${p}link3" reason="Never"/>
  <disable_collisions link1="${p}link1" link2="${p}link4" reason="Never"/>
  <disable_collisions link1="${p}link1" link2="${p}link5" reason="Never"/>
  <disable_collisions link1="${p}link1" link2="${p}link6" reason="Never"/>
  <disable_collisions link1="${p}link2" link2="${p}link3" reason="Adjacent"/>
  <disable_collisions link1="${p}link2" link2="${p}link4" reason="Never"/>
  <disable_collisions link1="${p}link2" link2="${p}link5" reason="Never"/>
  <disable_collisions link1="${p}link2" link2="${p}link6" reason="Never"/>
  <disable_collisions link1="${p}link3" link2="${p}link4" reason="Adjacent"/>
  <disable_collisions link1="${p}link3" link2="${p}link5" reason="Never"/>
  <disable_collisions link1="${p}link3" link2="${p}link6" reason="Never"/>
  <disable_collisions link1="${p}link4" link2="${p}link5" reason="Adjacent"/>
  <disable_collisions link1="${p}link4" link2="${p}link6" reason="Never"/>
  <disable_collisions link1="${p}link5" link2="${p}link6" reason="Adjacent"/>

  <!-- Disable self-collisions for Robotiq 2F-85 gripper -->
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="${p}grasp_tcp" link2="${p}flange" reason="Never"/>
  <disable_collisions link1="${p}grasp_tcp" link2="${p}robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="${p}grasp_tcp" link2="${p}robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="${p}grasp_tcp" link2="${p}robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_base_link" link2="${p}robotiq_85_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_base_link" link2="${p}robotiq_85_right_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_base_link" link2="${p}robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_base_link" link2="${p}robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_left_knuckle_link" link2="${p}robotiq_85_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_right_knuckle_link" link2="${p}robotiq_85_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_left_finger_link" link2="${p}robotiq_85_left_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_right_finger_link" link2="${p}robotiq_85_right_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="${p}flange" link2="${p}robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_left_finger_tip_link" link2="${p}robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_right_finger_tip_link" link2="${p}robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="${p}robotiq_85_left_knuckle_link" link2="${p}robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_right_knuckle_link" link2="${p}robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_left_finger_link" link2="${p}robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_right_finger_link" link2="${p}robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_left_finger_tip_link" link2="${p}robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_left_knuckle_link" link2="${p}robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="${p}link6" link2="${p}robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_base_link" link2="${p}robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_base_link" link2="${p}robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_base_link" link2="${p}robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="${p}robotiq_85_base_link" link2="${p}robotiq_85_right_finger_tip_link" reason="Never"/>
</robot>
