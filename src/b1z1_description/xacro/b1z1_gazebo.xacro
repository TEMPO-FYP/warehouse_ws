<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="p" value="$(arg prefix)"/>

    <!-- Macro for ground contact friction on each foot -->
    <xacro:macro name="foot_gazebo" params="foot_link">
        <gazebo reference="${foot_link}">
            <mu1>1.2</mu1>
            <mu2>1.2</mu2>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
        </gazebo>
    </xacro:macro>

    <!-- Macro for metallic visual styling on Z1 links -->
    <xacro:macro name="z1_link_visual" params="link_name amb diff spec">
        <gazebo reference="${link_name}">
            <visual>
                <material>
                    <ambient>${amb}</ambient>
                    <diffuse>${diff}</diffuse>
                    <specular>${spec}</specular>
                </material>
            </visual>
        </gazebo>
    </xacro:macro>

    <!-- Ground contact friction on all 4 feet -->
    <xacro:foot_gazebo foot_link="${p}FR_foot"/>
    <xacro:foot_gazebo foot_link="${p}FL_foot"/>
    <xacro:foot_gazebo foot_link="${p}RR_foot"/>
    <xacro:foot_gazebo foot_link="${p}RL_foot"/>

    <!-- Metallic styling for Z1 Arm in Gazebo -->
    <xacro:z1_link_visual link_name="${p}link00" amb="0.2 0.2 0.2 1.0" diff="0.25 0.25 0.25 1.0" spec="0.6 0.6 0.6 1.0"/>
    <xacro:z1_link_visual link_name="${p}link01" amb="0.2 0.2 0.2 1.0" diff="0.25 0.25 0.25 1.0" spec="0.6 0.6 0.6 1.0"/>
    <xacro:z1_link_visual link_name="${p}link02" amb="0.4 0.4 0.4 1.0" diff="0.55 0.55 0.55 1.0" spec="0.8 0.8 0.8 1.0"/>
    <xacro:z1_link_visual link_name="${p}link03" amb="0.4 0.4 0.4 1.0" diff="0.55 0.55 0.55 1.0" spec="0.8 0.8 0.8 1.0"/>
    <xacro:z1_link_visual link_name="${p}link04" amb="0.2 0.2 0.2 1.0" diff="0.25 0.25 0.25 1.0" spec="0.6 0.6 0.6 1.0"/>
    <xacro:z1_link_visual link_name="${p}link05" amb="0.2 0.2 0.2 1.0" diff="0.25 0.25 0.25 1.0" spec="0.6 0.6 0.6 1.0"/>
    <xacro:z1_link_visual link_name="${p}link06" amb="0.4 0.4 0.4 1.0" diff="0.55 0.55 0.55 1.0" spec="0.8 0.8 0.8 1.0"/>
    <gazebo reference="${p}gripperStator">
        <mu1>2.0</mu1>
        <mu2>2.0</mu2>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <visual>
            <material>
                <ambient>0.2 0.2 0.2 1.0</ambient>
                <diffuse>0.25 0.25 0.25 1.0</diffuse>
                <specular>0.5 0.5 0.5 1.0</specular>
            </material>
        </visual>
    </gazebo>
    <gazebo reference="${p}gripperMover">
        <mu1>2.0</mu1>
        <mu2>2.0</mu2>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <visual>
            <material>
                <ambient>0.1 0.1 0.1 1.0</ambient>
                <diffuse>0.15 0.15 0.15 1.0</diffuse>
                <specular>0.4 0.4 0.4 1.0</specular>
            </material>
        </visual>
    </gazebo>

    <!-- Preserve imu_link frame in SDFormat and attach IMU sensor -->
    <gazebo reference="imu_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="${p}imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>250</update_rate>
            <topic>/$(arg namespace)/imu/data</topic>
            <gz_frame_id>${p}imu_link</gz_frame_id>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2.0e-4</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2.0e-4</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2.0e-4</stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- Preserve lidar_link frame in SDFormat and attach 2D gpu_lidar sensor -->
    <gazebo reference="lidar_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="${p}lidar_link">
        <sensor name="gpu_lidar" type="gpu_lidar">
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>false</visualize>
            <topic>/$(arg namespace)/scan</topic>
            <gz_frame_id>${p}lidar_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>-2.35619</min_angle>
                        <max_angle>2.35619</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>0.0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.10</min>
                    <max>15.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

    <!-- Optional third-person follow camera sensor for headless MP4 recording -->
    <xacro:if value="$(arg enable_video_cam)">
        <gazebo reference="follow_camera_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>
        <gazebo reference="${p}follow_camera_link">
            <sensor name="video_camera" type="camera">
                <always_on>1</always_on>
                <update_rate>15</update_rate>
                <visualize>false</visualize>
                <topic>/$(arg namespace)/video_camera</topic>
                <camera>
                    <horizontal_fov>1.25</horizontal_fov>
                    <image>
                        <width>800</width>
                        <height>600</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>60.0</far>
                    </clip>
                </camera>
            </sensor>
        </gazebo>
    </xacro:if>

    <!-- Gazebo Sim system plugins for IMU, Ground-Truth Odometry, and ros2_control -->
    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_frame>${p}odom</odom_frame>
            <robot_base_frame>${p}base_footprint</robot_base_frame>
            <odom_topic>/$(arg namespace)/odom</odom_topic>
            <tf_topic>/$(arg namespace)/tf</tf_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <dimensions>3</dimensions>
        </plugin>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <xacro:if value="${'$(arg controllers_yaml)' != ''}">
                <parameters>$(arg controllers_yaml)</parameters>
            </xacro:if>
            <ros>
                <namespace>/$(arg namespace)</namespace>
            </ros>
            <position_proportional_gain>2.0</position_proportional_gain>
        </plugin>
        <plugin filename="libdynamic_attach_system.so" name="b1z1::DynamicAttachSystem">
            <parent_link>${p}link06</parent_link>
            <attach_topic>/$(arg namespace)/attach</attach_topic>
            <detach_topic>/$(arg namespace)/detach</detach_topic>
        </plugin>
    </gazebo>

    <!-- Macros for Hybrid ros2_control hardware interfaces -->
    <xacro:macro name="leg_ros2_control_joints" params="leg">
        <joint name="${leg}_hip_joint">
            <command_interface name="effort">
                <param name="min">${-hip_torque_max}</param>
                <param name="max">${hip_torque_max}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${leg}_thigh_joint">
            <command_interface name="effort">
                <param name="min">${-thigh_torque_max}</param>
                <param name="max">${thigh_torque_max}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.67</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${leg}_calf_joint">
            <command_interface name="effort">
                <param name="min">${-calf_torque_max}</param>
                <param name="max">${calf_torque_max}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">-1.30</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="arm_ros2_control_joint" params="name init_pos min_pos max_pos">
        <joint name="${name}">
            <command_interface name="position">
                <param name="min">${min_pos}</param>
                <param name="max">${max_pos}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">${init_pos}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <!-- Hybrid ros2_control system: effort on legs & gripper, position on Z1 arm -->
    <ros2_control name="b1z1_gz_system" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- 12 B1 Leg Joints (effort PID) -->
        <xacro:leg_ros2_control_joints leg="FR"/>
        <xacro:leg_ros2_control_joints leg="FL"/>
        <xacro:leg_ros2_control_joints leg="RR"/>
        <xacro:leg_ros2_control_joints leg="RL"/>

        <!-- 6 Z1 Arm Joints (position) -->
        <xacro:arm_ros2_control_joint name="joint1" init_pos="0.0"  min_pos="${joint1_PositionMin}" max_pos="${joint1_PositionMax}"/>
        <xacro:arm_ros2_control_joint name="joint2" init_pos="0.5"  min_pos="${joint2_PositionMin}" max_pos="${joint2_PositionMax}"/>
        <xacro:arm_ros2_control_joint name="joint3" init_pos="-0.5" min_pos="${joint3_PositionMin}" max_pos="${joint3_PositionMax}"/>
        <xacro:arm_ros2_control_joint name="joint4" init_pos="0.0"  min_pos="${joint4_PositionMin}" max_pos="${joint4_PositionMax}"/>
        <xacro:arm_ros2_control_joint name="joint5" init_pos="0.0"  min_pos="${joint5_PositionMin}" max_pos="${joint5_PositionMax}"/>
        <xacro:arm_ros2_control_joint name="joint6" init_pos="0.0"  min_pos="${joint6_PositionMin}" max_pos="${joint6_PositionMax}"/>

        <!-- Z1 Gripper Joint (effort PID for compliant physical squeeze torque) -->
        <joint name="jointGripper">
            <command_interface name="effort">
                <param name="min">-15.0</param>
                <param name="max">15.0</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">-1.3</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

</robot>
