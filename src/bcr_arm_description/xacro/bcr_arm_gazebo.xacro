<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="p" value="$(arg prefix)"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <xacro:if value="${'$(arg controllers_yaml)' != ''}">
        <parameters>$(arg controllers_yaml)</parameters>
      </xacro:if>
      <ros>
        <namespace>/$(arg namespace)</namespace>
      </ros>
      <position_proportional_gain>1.0</position_proportional_gain>
    </plugin>

    <plugin filename="libdynamic_attach_system.so" name="b1z1::DynamicAttachSystem">
      <parent_link>${p}flange</parent_link>
      <attach_topic>/$(arg namespace)/attach</attach_topic>
      <detach_topic>/$(arg namespace)/detach</detach_topic>
    </plugin>
  </gazebo>

  <xacro:macro name="bcr_arm_ros2_control_joint" params="name init_pos">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${init_pos}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="$(arg namespace)_gz_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:bcr_arm_ros2_control_joint name="joint1" init_pos="0.0347"/>
    <xacro:bcr_arm_ros2_control_joint name="joint2" init_pos="0.2729"/>
    <xacro:bcr_arm_ros2_control_joint name="joint3" init_pos="-1.3531"/>
    <xacro:bcr_arm_ros2_control_joint name="joint4" init_pos="1.1348"/>
    <xacro:bcr_arm_ros2_control_joint name="joint5" init_pos="2.5328"/>
    <xacro:bcr_arm_ros2_control_joint name="joint6" init_pos="-1.0486"/>
    <xacro:bcr_arm_ros2_control_joint name="joint7" init_pos="-1.145"/>
  </ros2_control>

</robot>
