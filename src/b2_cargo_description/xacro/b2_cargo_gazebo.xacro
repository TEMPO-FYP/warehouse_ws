<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="ns_prefix" value="${'/' + namespace if namespace != '' else ''}"/>

    <!-- Ground contact friction on all 4 feet -->
    <xacro:macro name="foot_gazebo" params="name">
        <gazebo reference="${name}_foot">
            <mu1>1.2</mu1>
            <mu2>1.2</mu2>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:foot_gazebo name="FR"/>
    <xacro:foot_gazebo name="FL"/>
    <xacro:foot_gazebo name="RR"/>
    <xacro:foot_gazebo name="RL"/>

    <!-- Preserve imu_link frame in SDFormat and attach IMU sensor -->
    <gazebo reference="imu_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>250</update_rate>
            <topic>${ns_prefix}/imu/data</topic>
            <gz_frame_id>${frame_prefix}imu_link</gz_frame_id>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2.0e-4</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2.0e-4</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2.0e-4</stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- Preserve lidar_link frame and attach 270 deg forward gpu_lidar (clears cargo rack) -->
    <gazebo reference="lidar_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="lidar_link">
        <sensor name="gpu_lidar" type="gpu_lidar">
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>false</visualize>
            <topic>${ns_prefix}/scan</topic>
            <gz_frame_id>${frame_prefix}lidar_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>720</samples>
                        <resolution>1</resolution>
                        <min_angle>-2.35619</min_angle>
                        <max_angle>2.35619</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>0.0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>15.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

    <!-- Gazebo Sim system plugins for IMU, Ground-Truth Odometry, and ros2_control -->
    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_frame>${frame_prefix}odom</odom_frame>
            <robot_base_frame>${frame_prefix}base_footprint</robot_base_frame>
            <odom_topic>${ns_prefix}/odom</odom_topic>
            <tf_topic>${ns_prefix}/tf</tf_topic>
            <odom_publish_frequency>50</odom_publish_frequency>
            <dimensions>3</dimensions>
        </plugin>
        <xacro:if value="${controllers_file != ''}">
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <xacro:if value="${namespace != ''}">
                    <ros>
                        <namespace>/${namespace}</namespace>
                    </ros>
                </xacro:if>
                <parameters>${controllers_file}</parameters>
                <position_proportional_gain>2.0</position_proportional_gain>
            </plugin>
        </xacro:if>
    </gazebo>

    <!-- Effort-controlled ros2_control leg joints -->
    <xacro:macro name="leg_ros2_control_joints" params="leg">
        <joint name="${leg}_hip_joint">
            <command_interface name="effort">
                <param name="min">${-hip_torque_max}</param>
                <param name="max">${hip_torque_max}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${leg}_thigh_joint">
            <command_interface name="effort">
                <param name="min">${-thigh_torque_max}</param>
                <param name="max">${thigh_torque_max}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.67</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="${leg}_calf_joint">
            <command_interface name="effort">
                <param name="min">${-calf_torque_max}</param>
                <param name="max">${calf_torque_max}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">-1.30</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <ros2_control name="b2_cargo_gz_system" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <xacro:leg_ros2_control_joints leg="FR"/>
        <xacro:leg_ros2_control_joints leg="FL"/>
        <xacro:leg_ros2_control_joints leg="RR"/>
        <xacro:leg_ros2_control_joints leg="RL"/>
    </ros2_control>

</robot>
