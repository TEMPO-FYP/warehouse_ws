<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tempo_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch package for the TEMPO multi-robot mission pipeline</description>
  <maintainer email="tz09220@st.habib.edu.pk">Taha Zahid</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>b1z1_control</exec_depend>
  <exec_depend>dispatcher_node</exec_depend>
  <exec_depend>launch</exec_depend>
