  <exec_depend>llm_planner</exec_depend>
  <exec_depend>robot_controllers</exec_depend>
  <exec_depend>solver_node</exec_depend>
  <exec_depend>warehouse_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
