<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>transport_robot_controller</name>
  <version>0.0.1</version>
  <description>
    TEMPO controller for the navigation-only transport robot
    (Clearpath Husky A200): executes navigate_to subtasks through Nav2.
  </description>
  <maintainer email="abdullahshheikh2@gmail.com">abdullah-shaikh</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>clearpath_nav2_demos</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>warehouse_sim</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
