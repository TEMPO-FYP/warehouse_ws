<?xml version="1.0" encoding="UTF-8"?>
<!--
  Empty test world for the Husky A200 + UR5e.
  World name is "default" so it matches world.name in controller_config.yaml.

  Layout (metres, world frame; warehouse_clearpath.launch.py spawns the
  robot at 0 -3 yaw 0 by default):
    - 12 x 12 m walled room
    - obstacle_1 (1.6, 0.0), between the spawn and the stands, and
      obstacle_2 (-2.5, -1.5)
    - pick_stand  (3.0,  2.0) with test_box on top (z 0.53)
    - place_stand (3.0, -2.0) with place_spot marker above it (z 0.56)
  robot_controllers/maps/empty_map.yaml is the map of this world; regenerate
  it if the static models change. Delete any model block you do not need.
-->
<sdf version="1.10">
  <world name="default">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <physics name="fast" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <pose>0 6.1 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <pose>0 -6.1 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <pose>6.1 0 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <pose>-6.1 0 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_1">
      <pose>1.6 0.0 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_2">
      <pose>-2.5 -1.5 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pick_stand">
      <pose>3.0 2.0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.55 0.35 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="test_box">
      <pose>3.0 2.0 0.53 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.1</mass><inertia><ixx>0.000060</ixx><iyy>0.000060</iyy><izz>0.000060</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.06 0.06 0.06</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="place_stand">
      <pose>3.0 -2.0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.55 0.35 1</ambient><diffuse>0.7 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="place_spot">
      <pose>3.0 -2.0 0.56 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>