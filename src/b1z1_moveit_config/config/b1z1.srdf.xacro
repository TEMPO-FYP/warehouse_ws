<?xml version="1.0" encoding="UTF-8"?>
<robot name="b1z1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="b1z1_"/>
  <xacro:property name="p" value="$(arg prefix)"/>

  <!-- Planning Groups -->
  <group name="z1_arm">
    <chain base_link="${p}link00" tip_link="${p}gripper_tcp"/>
  </group>

  <group name="z1_gripper">
    <joint name="jointGripper"/>
  </group>

  <!-- Named Group States (z1_arm) -->
  <group_state name="home" group="z1_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.5"/>
    <joint name="joint3" value="-0.5"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="ready" group="z1_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="1.0"/>
    <joint name="joint3" value="-1.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="pre_fold" group="z1_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.8"/>
    <joint name="joint3" value="-0.95"/>
    <joint name="joint4" value="-0.95"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="1.57"/>
  </group_state>

  <group_state name="carry_retract" group="z1_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.50"/>
    <joint name="joint3" value="-0.45"/>
    <joint name="joint4" value="-0.45"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="1.57"/>
  </group_state>

  <group_state name="carry" group="z1_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.50"/>
    <joint name="joint3" value="-0.45"/>
    <joint name="joint4" value="-0.45"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <!-- Named Group States (z1_gripper) -->
  <group_state name="open" group="z1_gripper">
    <joint name="jointGripper" value="-1.50"/>
  </group_state>

  <group_state name="close" group="z1_gripper">
    <joint name="jointGripper" value="-0.05"/>
  </group_state>

  <group_state name="attach" group="z1_gripper">
    <joint name="jointGripper" value="-1.25"/>
  </group_state>

  <!-- End Effector -->
  <end_effector name="gripper_ee" parent_link="${p}gripper_tcp" group="z1_gripper" parent_group="z1_arm"/>

  <!-- Virtual Joint connecting robot base to odometry frame -->
  <virtual_joint name="virtual_joint" type="floating" parent_frame="${p}odom" child_link="${p}base_link"/>

  <!-- Disable self-collisions for adjacent and rigidly connected links -->
  <disable_collisions link1="${p}base_link" link2="${p}trunk" reason="Adjacent"/>
  <disable_collisions link1="${p}trunk" link2="${p}imu_link" reason="Adjacent"/>
  <disable_collisions link1="${p}trunk" link2="${p}lidar_link" reason="Adjacent"/>
  <disable_collisions link1="${p}imu_link" link2="${p}lidar_link" reason="Never"/>
  <disable_collisions link1="${p}lidar_link" link2="${p}link00" reason="Never"/>
  <disable_collisions link1="${p}trunk" link2="${p}link00" reason="Adjacent"/>
  <disable_collisions link1="${p}trunk" link2="${p}link01" reason="Never"/>
  <disable_collisions link1="${p}trunk" link2="${p}link02" reason="Never"/>

  <disable_collisions link1="${p}link00" link2="${p}link01" reason="Adjacent"/>
  <disable_collisions link1="${p}link00" link2="${p}link02" reason="Never"/>
  <disable_collisions link1="${p}link01" link2="${p}link02" reason="Adjacent"/>
  <disable_collisions link1="${p}link02" link2="${p}link03" reason="Adjacent"/>
  <disable_collisions link1="${p}link02" link2="${p}link04" reason="Never"/>
  <disable_collisions link1="${p}link03" link2="${p}link04" reason="Adjacent"/>
  <disable_collisions link1="${p}link03" link2="${p}link05" reason="Never"/>
  <disable_collisions link1="${p}link03" link2="${p}link06" reason="Never"/>
  <disable_collisions link1="${p}link03" link2="${p}gripperStator" reason="Never"/>
  <disable_collisions link1="${p}link04" link2="${p}link05" reason="Adjacent"/>
  <disable_collisions link1="${p}link04" link2="${p}link06" reason="Never"/>
  <disable_collisions link1="${p}link04" link2="${p}gripperStator" reason="Never"/>
  <disable_collisions link1="${p}link04" link2="${p}gripperMover" reason="Never"/>
  <disable_collisions link1="${p}link05" link2="${p}link06" reason="Adjacent"/>
  <disable_collisions link1="${p}link05" link2="${p}gripperStator" reason="Never"/>
  <disable_collisions link1="${p}link06" link2="${p}gripperStator" reason="Adjacent"/>
  <disable_collisions link1="${p}link06" link2="${p}gripperMover" reason="Never"/>
  <disable_collisions link1="${p}gripperStator" link2="${p}gripperMover" reason="Adjacent"/>
  <disable_collisions link1="${p}gripperStator" link2="${p}gripper_tcp" reason="Adjacent"/>
  <disable_collisions link1="${p}gripperMover" link2="${p}gripper_tcp" reason="Adjacent"/>

  <!-- Leg adjacent & trunk collisions -->
  <xacro:macro name="leg_disable_collisions" params="leg">
    <disable_collisions link1="${p}trunk" link2="${p}${leg}_hip" reason="Adjacent"/>
    <disable_collisions link1="${p}trunk" link2="${p}${leg}_hip_rotor" reason="Adjacent"/>
    <disable_collisions link1="${p}trunk" link2="${p}${leg}_thigh" reason="Never"/>
    <disable_collisions link1="${p}${leg}_hip" link2="${p}${leg}_thigh" reason="Adjacent"/>
    <disable_collisions link1="${p}${leg}_hip" link2="${p}${leg}_hip_rotor" reason="Never"/>
    <disable_collisions link1="${p}${leg}_hip" link2="${p}${leg}_thigh_rotor" reason="Adjacent"/>
    <disable_collisions link1="${p}${leg}_thigh" link2="${p}${leg}_thigh_rotor" reason="Never"/>
    <disable_collisions link1="${p}${leg}_thigh" link2="${p}${leg}_calf" reason="Adjacent"/>
    <disable_collisions link1="${p}${leg}_thigh" link2="${p}${leg}_calf_rotor" reason="Adjacent"/>
    <disable_collisions link1="${p}${leg}_calf" link2="${p}${leg}_calf_rotor" reason="Never"/>
    <disable_collisions link1="${p}${leg}_calf" link2="${p}${leg}_foot" reason="Adjacent"/>
  </xacro:macro>

  <xacro:leg_disable_collisions leg="FL"/>
  <xacro:leg_disable_collisions leg="FR"/>
  <xacro:leg_disable_collisions leg="RL"/>
  <xacro:leg_disable_collisions leg="RR"/>
</robot>
