<?xml version="1.0" encoding="UTF-8"?>
<robot name="b1z1">
  <!-- Planning Groups -->
  <group name="z1_arm">
    <chain base_link="link00" tip_link="gripper_tcp"/>
  </group>

  <group name="z1_gripper">
    <joint name="jointGripper"/>
  </group>

  <!-- Named Group States -->
  <group_state name="home" group="z1_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.5"/>
    <joint name="joint3" value="-0.5"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="ready" group="z1_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="1.0"/>
    <joint name="joint3" value="-1.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <group_state name="open" group="z1_gripper">
    <joint name="jointGripper" value="-1.3"/>
  </group_state>

  <group_state name="close" group="z1_gripper">
    <joint name="jointGripper" value="-0.05"/>
  </group_state>

  <!-- End Effector -->
  <end_effector name="gripper_ee" parent_link="gripper_tcp" group="z1_gripper" parent_group="z1_arm"/>

  <!-- Virtual Joint connecting robot base to odometry frame -->
  <virtual_joint name="virtual_joint" type="floating" parent_frame="odom" child_link="base_link"/>

  <!-- Disable self-collisions for adjacent and rigidly connected links -->
  <disable_collisions link1="base_link" link2="trunk" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="imu_link" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="lidar_link" reason="Adjacent"/>
  <disable_collisions link1="imu_link" link2="lidar_link" reason="Never"/>
  <disable_collisions link1="lidar_link" link2="link00" reason="Never"/>
  <disable_collisions link1="lidar_link" link2="link01" reason="Never"/>
  <disable_collisions link1="lidar_link" link2="link02" reason="Never"/>
  <disable_collisions link1="lidar_link" link2="link03" reason="Never"/>
  <disable_collisions link1="trunk" link2="link00" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="link01" reason="Never"/>
  <disable_collisions link1="trunk" link2="link02" reason="Never"/>

  <disable_collisions link1="link00" link2="link01" reason="Adjacent"/>
  <disable_collisions link1="link00" link2="link02" reason="Never"/>
  <disable_collisions link1="link01" link2="link02" reason="Adjacent"/>
  <disable_collisions link1="link02" link2="link03" reason="Adjacent"/>
  <disable_collisions link1="link02" link2="link04" reason="Never"/>
  <disable_collisions link1="link03" link2="link04" reason="Adjacent"/>
  <disable_collisions link1="link03" link2="link05" reason="Never"/>
  <disable_collisions link1="link03" link2="link06" reason="Never"/>
  <disable_collisions link1="link03" link2="gripperStator" reason="Never"/>
  <disable_collisions link1="link04" link2="link05" reason="Adjacent"/>
  <disable_collisions link1="link04" link2="link06" reason="Never"/>
  <disable_collisions link1="link04" link2="gripperStator" reason="Never"/>
  <disable_collisions link1="link04" link2="gripperMover" reason="Never"/>
  <disable_collisions link1="link05" link2="link06" reason="Adjacent"/>
  <disable_collisions link1="link05" link2="gripperStator" reason="Never"/>
  <disable_collisions link1="link06" link2="gripperStator" reason="Adjacent"/>
  <disable_collisions link1="link06" link2="gripperMover" reason="Never"/>
  <disable_collisions link1="gripperStator" link2="gripperMover" reason="Adjacent"/>
  <disable_collisions link1="gripperStator" link2="gripper_tcp" reason="Adjacent"/>
  <disable_collisions link1="gripperMover" link2="gripper_tcp" reason="Adjacent"/>

  <!-- Leg adjacent & trunk collisions -->
  <disable_collisions link1="trunk" link2="FL_hip" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="FR_hip" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="RL_hip" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="RR_hip" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="FL_hip_rotor" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="FR_hip_rotor" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="RL_hip_rotor" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="RR_hip_rotor" reason="Adjacent"/>
  <disable_collisions link1="trunk" link2="FL_thigh" reason="Never"/>
  <disable_collisions link1="trunk" link2="FR_thigh" reason="Never"/>
  <disable_collisions link1="trunk" link2="RL_thigh" reason="Never"/>
  <disable_collisions link1="trunk" link2="RR_thigh" reason="Never"/>

  <disable_collisions link1="FL_hip" link2="FL_thigh" reason="Adjacent"/>
  <disable_collisions link1="FL_hip" link2="FL_hip_rotor" reason="Never"/>
  <disable_collisions link1="FL_hip" link2="FL_thigh_rotor" reason="Adjacent"/>
  <disable_collisions link1="FL_thigh" link2="FL_thigh_rotor" reason="Never"/>
  <disable_collisions link1="FL_thigh" link2="FL_calf" reason="Adjacent"/>
  <disable_collisions link1="FL_thigh" link2="FL_calf_rotor" reason="Adjacent"/>
  <disable_collisions link1="FL_calf" link2="FL_calf_rotor" reason="Never"/>
  <disable_collisions link1="FL_calf" link2="FL_foot" reason="Adjacent"/>

  <disable_collisions link1="FR_hip" link2="FR_thigh" reason="Adjacent"/>
  <disable_collisions link1="FR_hip" link2="FR_hip_rotor" reason="Never"/>
  <disable_collisions link1="FR_hip" link2="FR_thigh_rotor" reason="Adjacent"/>
  <disable_collisions link1="FR_thigh" link2="FR_thigh_rotor" reason="Never"/>
  <disable_collisions link1="FR_thigh" link2="FR_calf" reason="Adjacent"/>
  <disable_collisions link1="FR_thigh" link2="FR_calf_rotor" reason="Adjacent"/>
  <disable_collisions link1="FR_calf" link2="FR_calf_rotor" reason="Never"/>
  <disable_collisions link1="FR_calf" link2="FR_foot" reason="Adjacent"/>

  <disable_collisions link1="RL_hip" link2="RL_thigh" reason="Adjacent"/>
  <disable_collisions link1="RL_hip" link2="RL_hip_rotor" reason="Never"/>
  <disable_collisions link1="RL_hip" link2="RL_thigh_rotor" reason="Adjacent"/>
  <disable_collisions link1="RL_thigh" link2="RL_thigh_rotor" reason="Never"/>
  <disable_collisions link1="RL_thigh" link2="RL_calf" reason="Adjacent"/>
  <disable_collisions link1="RL_thigh" link2="RL_calf_rotor" reason="Adjacent"/>
  <disable_collisions link1="RL_calf" link2="RL_calf_rotor" reason="Never"/>
  <disable_collisions link1="RL_calf" link2="RL_foot" reason="Adjacent"/>

  <disable_collisions link1="RR_hip" link2="RR_thigh" reason="Adjacent"/>
  <disable_collisions link1="RR_hip" link2="RR_hip_rotor" reason="Never"/>
  <disable_collisions link1="RR_hip" link2="RR_thigh_rotor" reason="Adjacent"/>
  <disable_collisions link1="RR_thigh" link2="RR_thigh_rotor" reason="Never"/>
  <disable_collisions link1="RR_thigh" link2="RR_calf" reason="Adjacent"/>
  <disable_collisions link1="RR_thigh" link2="RR_calf_rotor" reason="Adjacent"/>
  <disable_collisions link1="RR_calf" link2="RR_calf_rotor" reason="Never"/>
  <disable_collisions link1="RR_calf" link2="RR_foot" reason="Adjacent"/>
</robot>
